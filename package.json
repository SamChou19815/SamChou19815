{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "check": "turbo run check",
    "build": "turbo run build",
    "format": "oxfmt .",
    "lint": "oxlint && oxfmt --check .",
    "fix": "oxlint --fix && oxfmt .",
    "build:cli": "cargo build --release -p sam-cli",
    "cli": "pnpm build:cli > /dev/null 2> /dev/null && ./target/release/sam",
    "bump": "pnpm up -r --latest @types/node @types/react @types/react-dom typescript turbo oxlint oxfmt",
    "dev": "pnpm --filter www dev"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.0.0+sha512.b8fef5494bd3fe4cbd4edabd0745df2ee5be3e4b0b8b08fa643aa3e4c6702ccc0f00d68fa8a8c9858a735a0032485a44990ed2810526c875e416f001b17df12b"
}

# committed, so `tsc`/oxlint run on a fresh clone without a Rust toolchain.
packages/www/src/app/generated/*
!packages/www/src/app/generated/sam_tui.d.ts
**/.next
/target
server/target
*.tsbuildinfo
*.js.map

